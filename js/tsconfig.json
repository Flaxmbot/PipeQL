{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "outDir": "./src",
    "rootDir": "./src-ts",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src-ts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
